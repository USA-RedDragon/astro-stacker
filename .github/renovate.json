{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs",
        "local>USA-RedDragon/renovate-configs:golang"
    ],
    "packageRules": [
        {
            "matchFileNames": ["tessjob/requirements.txt"],
            "matchPackageNames": ["numpy"],
            "allowedVersions": "<2"
        },
        {
            "matchFileNames": ["tessjob/requirements.txt"],
            "matchPackageNames": ["contourpy"],
            "allowedVersions": "<1.4"
        },
        {
            "matchFileNames": ["tessjob/requirements.txt"],
            "matchPackageNames": ["astroquery"],
            "enabled": false
        },
        {
            "matchFileNames": ["tessjob/requirements.txt"],
            "matchPackageNames": ["astropy"],
            "allowedVersions": "<6.2"
        },
        {
            "matchFileNames": ["tessjob/requirements.txt"],
            "matchPackageNames": ["scipy"],
            "allowedVersions": "<1.18"
        },
        {
            "matchFileNames": ["tessjob/requirements.txt"],
            "matchPackageNames": ["wotan"],
            "allowedVersions": "<2"
        },
        {
            "matchFileNames": ["tessjob/Dockerfile", ".github/workflows/tess.yaml"],
            "matchPackageNames": ["python", "actions/python-versions"],
            "allowedVersions": "<3.13"
        },
        {
            "matchFileNames": ["smallbodies/requirements.txt"],
            "matchPackageNames": ["rebound"],
            "allowedVersions": "<5"
        }
    ]
}
